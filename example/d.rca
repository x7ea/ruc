fn gtk_init(argc: (), argv: ()) -> ()
fn gtk_window_new(_: ()) -> App
fn gtk_window_set_default_size(app: App, width: Int, height: Int) -> ()
fn gtk_button_new_with_label(content: Str) -> Elm
fn gtk_container_add(app: App, elm: Elm) -> ()
fn g_signal_connect_data<T>(elm: Elm, event: Str, handle: ()(Elm, T), data: T) -> ()
fn g_signal_connect_object(app: App, event: Str, handle: ()(), object: ()) -> ()
fn gtk_button_set_label(elm: Elm, content: Str) -> ()
fn gtk_widget_show_all(window: App) -> ()
fn gtk_main() -> ()
fn gtk_main_quit() -> ()

fn App() {
    gtk_init((), ())
    let this = gtk_window_new(())
    gtk_window_set_default_size(this, 500, 300)
    g_signal_connect_object(this, "destroy", gtk_main_quit, 0)
    this
}

fn button(content: Str) {
    gtk_button_new_with_label(content)
}

fn on_click(this: Elm, data: T, handle: ()(Elm, T)) {
    g_signal_connect_data<T>(this, "clicked", handle, data)
}

fn run(this: App) {
    gtk_widget_show_all(this)
    gtk_main()
}

