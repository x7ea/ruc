enum Result<T, E> {
    ok: T,
    err: E
}

fn unwrap_or<T, E>(this: Result<T, E>, alt: T) {
    if let v = this.ok then v else alt
}

fn main() {
    let value = new Result<Int, Str>
    let alt = 5

    let value.ok = 3
    print unwrap_or(value, alt)

    let value.err = "Err"
    print unwrap_or(value, alt)
}
