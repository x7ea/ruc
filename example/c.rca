fn reduce<T>(this: [T], lambda: T(T, T)) {
    let index = 1
    while index < this.len do {
        let this[0] = lambda(this[0], this[index])
        let index = index + 1
    }
    this[0]
}

fn add<T>(a: T, b: T) a + b

fn main() {
    let x = [Int; 3]
    let x[0] = 1
    let x[1] = 2
    let x[2] = 4

    print reduce<Int>(x, add<Int>)

    let y = [Float; 2]
    let y[0] = 1.2
    let y[1] = 2.3

    print reduce<Float>(y, add<Float>)
}
