fn reduce<T>(this: [T], lambda: T(T, T)) {
    let index = 1
    while index < this.len do {
        let this[0] = lambda(this[0], this[index])
        let index = index + 1
    }
    this[0]
}

fn add<T>(a: T, b: T) a + b

fn main() {
    let seq = [Int; 3]
    let seq[0] = 1
    let seq[1] = 2
    let seq[2] = 4

    let sum = reduce<Int>(seq, add<Int>)
    print sum

    let b = [Float; 2]
    let b[0] = 1.2
    let b[1] = 2.3

    let sum1 = reduce<Float>(b, add<Float>)
    print sum1
}
