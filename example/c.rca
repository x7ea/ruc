fn reduce<T>(this: [T], lambda: T(T, T)) {
    let index = 1
    while index < this.len do {
        let this[0] = lambda(this[0], this[index])
        let index = index + 1
    }
    this[0]
}

fn add<T>(a: T, b: T) a + b

fn sum_int() {
    let seq = [Int; 3]
    let seq[0] = 1
    let seq[1] = 2
    let seq[2] = 4

    reduce<Int>(seq, add<Int>)
}

fn sum_float() {
    let seq = [Float; 2]
    let seq[0] = 1.2
    let seq[1] = 2.3

    reduce<Float>(seq, add<Float>)
}


fn main() {
    print sum_int()
    print sum_float()
}
