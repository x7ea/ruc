enum State {
    fizzbuzz: (),
    fizz: (),
    buzz: (),
    number: Int
}

fn eval(n: Int) {
    let this = new State
    if n % 15 == 0 then {
        let this.fizzbuzz = ()
    } else if n % 3 == 0 then {
        let this.fizz = ()
    } else if n % 5 == 0 then {
        let this.buzz = ()
    } else {
        let this.number = n
    }
    this
}

fn display(this: State) {
    match this {
        fizz = print "Fizz",
        buzz = print "Buzz",
        fizzbuzz = print "FizzBuzz",
        number i = print i
    }
}

fn main() {
    let i = 0
    while i < 100 do {
        let i = i + 1
        let state = eval(i)
        display(state)
    }
}
