struct List<T> {
    car: T,
    cdr: List<T>
}

fn node(value: Int) {
    let this = new List<Int>
    let this.car = value
    this
}

fn link<T>(this: List<T>, other: List<T>) {
    let this.cdr = other
}

fn main() {
    let a = node(100)
    let b = node(200)
    let c = node(300)
    link<Int>(a, b)
    link<Int>(b, c)

    print a.cdr.car     ; 200
    print b.cdr.car     ; 300
    print c.cdr.car     ; null
}
