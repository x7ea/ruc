struct List<T> {
    car: T,
    cdr: List
}

fn node(value: Int) {
    let this = new List<Int>
    let this.car = value
    this
}

fn link<T>(this: List<T>, other: List<T>) {
    while this.cdr? do {
        let this = this.cdr
    }
    let this.cdr = other
    this
}

fn main() {
    let a = node(100)
    let b = node(200)
    let c = node(300)
    link<Int>(link<Int>(a, b), c)

    print a.cdr.car     ; 200
    print b.cdr.car     ; 300
    print c.cdr.car     ; null
}
