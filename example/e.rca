struct List<T> {
    car: T,
    cdr: List<T>
}

List<T> link<T>(this: List<T>, other: List<T>) {
    while this.cdr? do {
        let this = this.cdr
    }
    let this.cdr = other
    this
}

List<Int> node(value: Int) {
    let this = new List<Int>
    let this.car = value
    this
}

() main() {
    let a = node(100)
    let b = node(200)
    let c = node(300)
    link<Int>(a, link<Int>(b, c))

    print a.cdr.car     ; 200
    print b.cdr.car     ; 300
    print c.cdr.car     ; null
}
