struct List<T> {
    car: Int,
    cdr: List
}

fn node<T>(value: T) {
    let this = new List<T>
    let this.car = value
    this
}

fn link<T>(this: List<T>, other: List) {
    while this.cdr? do {
        let this = this.cdr
    }
    let this.cdr = other
    this
}

fn main() {
    let a = node<Int>(100)
    let b = node<Int>(200)
    let c = node<Int>(300)
    link<Int>(link<Int>(a, b), c)

    print a.cdr.car     ; 200
    print b.cdr.car     ; 300
    print c.cdr.car     ; null
}
