enum State {
    fizzbuzz: (),
    fizz: (),
    buzz: (),
    number: Int
}

fn eval(n: Int) {
    let this = new State
    let this.number = n
    if n % 3 == 0 then let this.fizz = ()
    if n % 5 == 0 then let this.buzz = ()
    if n % 15 == 0 then let this.fizzbuzz = ()
    this
}

fn display(this: State) {
    if this.fizz? then print "Fizz"
    if this.buzz? then print "Buzz"
    if this.fizzbuzz? then print "FizzBuzz"
    if let n = this.number then print n
}

fn main() {
    let i = 0
    while i < 100 do {
        let i = i + 1
        let state = eval(i)
        display(state)
    }
}
