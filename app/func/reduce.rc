use std

fn reduce<T>(this: [T], lambda: T(T, T)): T {
    let acc: T
    for i = this do {
        let acc = lambda(acc, i)
    }
    acc
}

fn add<T>(a: T, b: T): T a + b

fn main() {
    let x = [8, 5, 4, 6, 2]
    print reduce<Int>(x, add<Int>)

    let y = [1.2, 2.3, 4.0]
    print reduce<Float>(y, add<Float>)
}
