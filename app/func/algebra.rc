use std

enum Sum<A, B> { a: A, b: B }
struct Product<A, B> { a: A, b: B }

fn Algebra.print<T>(this: T): Str {
    format this.a, this.b
}
fn Product.print<A, B>(this: Product<A, B>): Str format this.a, this.b

fn main() {
    let x = new Sum<Str, Int>
    let y = new Product<Float, Str>

    let x.a = "Hoge"
    let x.b = 123
    print x

    let y.a = 456.7
    let y.b = "Fuga"
    print y
}
