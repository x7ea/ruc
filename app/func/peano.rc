use std

enum Peano {
    zero: (),
    succ: Peano
}

fn Peano.add(n: Peano, m: Peano): Peano '
match m {
    Zero = clone n,
    Succ m = Peano::Succ(n + m)
}

fn Peano.print(this: Peano): Int '
    if let n = this.succ then n.print() + 1 else 0

fn main() {
    let one = Peano::Succ(Peano::Zero)
    print "1 + 1 = ", one + one
}
