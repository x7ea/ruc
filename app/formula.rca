enum Expr {
    add: Term,
    mul: Term,
    neg: Expr,
    rec: Expr,
    number: Float
}

struct Term {
    lhs: Expr,
    rhs: Expr
}

fn eval(this: Expr) -> Float {
    match this {
        add op = eval(op.lhs) + eval(op.rhs),
        mul op = eval(op.lhs) * eval(op.rhs),
        neg v = 0.0 - eval(v),
        rec v = 1.0 / eval(v),
        number i = i
    }
}
