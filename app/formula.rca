enum Peano {
    Zero: (),
    Succ: Peano
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        Zero = clone lhs,
        Succ n = Peano::Succ(add(lhs, n))
    }
}

fn decode(this: Peano) -> Int {
    if let n = this.Succ then {
        decode(n) + 1
    }
}

fn main() {
    let one = Peano::Succ(Peano::Zero)
    let proof = one.add(one)
    print proof.decode()
}
