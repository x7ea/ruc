enum Expr {
    add: Term,
    mul: Term,
    neg: Expr,
    rec: Expr,
    number: Float
}

struct Term {
    lhs: Expr,
    rhs: Expr
}
cat app/formula.rca | RUST_BACKTRACE=1 cargo run

fn eval(this: Expr) -> Float {
    match this {
        add term = eval(term.lhs) + eval(term.rhs),
        mul term = eval(term.lhs) * eval(term.rhs),
        neg e = 0.0 - eval(e),
        rec e = 1.0 / eval(e),
        number i = i
    }
}
