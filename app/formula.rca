enum Peano {
    zero: (),
    S: Peano
}

fn zero() {
    let this = new Peano
    let this.zero = ()
    this
}

fn S(n: Peano) {
    let this = new Peano
    let this.S = n
    this
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        zero = lhs,
        S n = S(add(lhs, n))
    }
}

fn decode(this: Peano) -> Int {
    match this {
        zero = 0,
        S n = decode(n) + 1
    }
}

fn to_str(this: Peano) -> Str {
    match this {
        zero = "0",
        S n = (format "S(", n, ")")
    }
}

fn main() {
    let one = S(zero())
    print to_str(one)
    let proof = add(one, one)
    print decode(one)
}
