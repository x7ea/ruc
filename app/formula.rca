enum Expr {
    add: Term,
    mul: Term,
    neg: Expr,
    rec: Expr,
    number: Float
}

struct Term {
    lhs: Expr,
    rhs: Expr
}

fn eval(this: Expr) {
    match this {
        add term = eval(term.lhs) + eval(term.rhs),
        mul term = eval(term.lhs) * eval(term.rhs),
        neg e = 0.0 - eval(e),
        rec e = 1.0 / eval(e),
        number i = i
    }
}
