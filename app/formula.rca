enum Peano {
    zero: (),
    S: Peano
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        zero = lhs,
        S n = add(n, lhs)
    }
}

fn decode(this: Peano) -> Int {
    match this {
        zero = 0,
        S n = decode(n) + 1
    }
}

fn peano(n: Int) -> Peano {
    let this = new Peano
    if n == 0 then {
        let this.zero = ()
    } else {
        let this.S = peano(n - 1)
    }
    this
}

fn main() {
    let one = peano(1)
    let proof = add(one, one)
    print decode(proof)
}
