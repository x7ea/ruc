enum Peano {
    Zero: (),
    Succ: Peano
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        Zero = lhs,
        Succ n = Peano::Succ(add(lhs, n))
    }
}
fn decode(this: Peano) -> Int {
    match this {
        Zero = 0,
        Succ n = decode(n) + 1
    }
}

fn main() {
    let one = Peano::Succ(Peano::Zero)
    let proof = Peano::Zero.add(one)
    print proof.decode()
}
