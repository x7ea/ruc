enum Peano {
    Zero: (),
    Succ: Peano
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        Zero = lhs,
        Succ n = Peano::Succ(add(lhs, n))
    }
}
fn s(this: Peano) -> Str {
    match this {
        Zero = "Zero",
        Succ n = (format "Succ(", s(n), ")")
    }
}

fn main() {
    let one = Peano::Succ(Peano::Zero)
    let proof = one.add(one)
    print proof.s()
}
