enum Peano {
    zero: (),
    S: Peano
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        zero = lhs,
        S n = Peano::S(add(lhs, n))
    }
}

fn decode(this: Peano) -> Int {
    match this {
        zero = 0,
        S n = decode(n) + 1
    }
}

fn main() {
    let proof = add(
        Peano::S(Peano::zero),
        Peano::S(Peano::zero)
    )
    print decode(proof)
}
