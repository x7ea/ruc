enum Peano {
    Zero: (),
    Succ: Peano
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        Zero = clone lhs,
        Succ n = Peano::Succ(add(lhs, n))
    }
}
fn decode(this: Peano) -> Int {
    match this {
        Zero = 0,
        Succ n = decode(n) + 1
    }
}

fn main() {
    let proof = add(
        Peano::Succ(Peano::Zero),
        Peano::Zero
    )
    print proof.decode()
}
