enum Peano {
    zero: (),
    S: Peano
}

fn zero() {
    let this = new Peano
    let this.zero = ()
    this
}

fn S(n: Peano) {
    let this = new Peano
    let this.S = n
    this
}

fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        zero = lhs,
        S n = S(add(lhs, n))
    }
}

fn decode(this: Peano) -> Int {
    match this {
        zero = 0,
        S n = decode(n) + 1
    }
}

fn main() {
    let one = S(zero())
    let proof = add(one, one)
    print decode(proof)
}
