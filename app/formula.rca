enum Peano {
    Zero: (),
    Succ: Peano
}

fn decode(this: Peano) -> Int {
    match this {
        Zero = 0,
        Succ n = decode(n) + 1
    }
}


fn add(lhs: Peano, rhs: Peano) -> Peano {
    match rhs {
        Zero = lhs,
        Succ n = {
            print lhs.decode()
            print n.decode()
            Peano::Succ(add(lhs, n))
        }
    }
}


fn main() {
    let one = Peano::Succ(Peano::Zero)
    let proof = one.add(one)
    print proof.decode()
}
