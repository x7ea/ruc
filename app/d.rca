use gtk

struct State {
    count: Int
}

fn increment(this: Elm, data: State) {
    let data.count = data.count + 1
    let view = format "Count: ", data.count
    this.update(view)
}

fn main() {
    let app = App()
    let data = new State
    let btn = app.button("Counter App")
    btn.on_click<State>(data, increment)
    app.run()
}
