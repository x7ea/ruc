use std

fn expr(): Int {
    let token = input()
    if strcmp(token, "+") == 0 then {
        let a = expr()
        let b = expr()
        a + b
    } else if strcmp(token, "-") == 0 then {
        let a = expr()
        let b = expr()
        a - b
    } else if strcmp(token, "*") == 0 then {
        let a = expr()
        let b = expr()
        a * b
    } else if strcmp(token, "/") == 0 then {
        let a = expr()
        let b = expr()
        a / b
    } else {
        token.atoi()
    }
}

fn main() {
    print expr()
}
