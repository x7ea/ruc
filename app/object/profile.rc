use std

struct Chip {
    rax: Int,
}

fn Profile(name: Str) {
    let this = new Profile
    let this.name = name
    let this.age = 0.0
    this
}

fn Profile.greet(this: Profile) {
    print this.name, " (", this.age, ")"
}

fn main() {
    let me = Profile("x7ea")
    let she.name = "x7ea"
    let she.age = 17.2
    she.greet()
}
