use std

struct User<T> {
    name: Str,
    email: T
}

fn User(name: Str): User {
    let this = new User
    let this.name = name
    this
}

struct Email { address: Str }
fn Email.send(this: Email) {
    print "Send: ", this.address
}

struct Phone { number: Int }
fn Phone.send(this: Email) {
    print "Call: ", this.number
}

fn User.email(this: User, age: Float) {
    let this.age = age
}

fn User.print(this: User): Str {
    format this.name, " (", this.age, ")"
}

fn main() {
    let me = User("x7ea")
    me.set_age(17.4)
    print me
}
