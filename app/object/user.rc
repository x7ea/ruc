use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User<Message>(name: Str, inject: Message): User<Message> {
    let this = new User<Message>
    let this.name = name
    let this.contact = inject
    this
}

struct Email { address: Str }
fn Email.send(this: Email) {
    print "Send: ", this.address
}

struct Phone { number: Int }
fn Phone.send(this: Phone) {
    print "Call: ", this.number
}

fn main() {
    let me = User<Email>("x7ea", new Email)
    me.contact.send()
}
