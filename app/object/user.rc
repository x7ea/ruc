use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User<T>(name: Str, inject: T): User<T> {
    let this = new User<T>
    let this.contact = inject
    let this.name = name
    this
}

struct Email {
    address: Str
}
fn Email.edit(this: Email, update: Str) '
    let this.address = update
fn Email.access(this: Email) '
    print "Send: ", this.address

fn main() {
    let me = User<Email>("x7ea", new Email)
    me.contact.edit(me.name + "@example.com")
    me.contact.access()
}
