use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User<T>(name: Str, inject: T): User<T> {
    let this = new User<T>
    let this.contact = inject
    let this.name = name
    this
}

fn User.verify<T>(this: User<T>) {
    this.contact.edit(this.name + "@example.com")
    this.contact.access()
}

struct Email {
    address: Str
}
fn Email.edit(this: Email, update: Str) '
    let this.address = update
fn Email.access(this: Email) '
    print "Send: ", this.address

struct Phone {
    number: Int
}
fn Phone.edit(this: Phone, update: Int) '
    let this.number = update
fn Phone.access(this: Phone) '
    print "Call: ", this.number

fn main() {
    let my = User<Email>("x7ea", new Email)
    my.verify()

    sub.contact.edit(1145141919)
    sub.contact.access()
}
