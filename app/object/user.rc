use std

struct User {
    name: Str,
    age: Float
}

fn User(name: Str): User {
    let this = new User
    let this.name = name
    this
}

fn User.set_age(this: User, age: Float) {
    let this.age = age
}

fn User.print(this: User): Str {
    format this.name, " (", this.age, ")"
}

fn main() {
    let me = User("x7ea")
    me.set_age(17.4)
    print me
}
