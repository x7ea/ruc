use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User<Message>(name: Str, inject: Message): User<Message> {
    let this = new User<Message>
    let this.contact = inject
    let this.name = name
    this
}

struct Email { address: Str }
fn Email.edit(this: Email, update: Str) let this.address = update
fn Email.access(this: Email) print "Send: ", this.address

fn main() {
    let me = User<Email>("x7ea", new Email)
    me.contact.edit("x7ea@example.com")
    me.contact.access()
}
