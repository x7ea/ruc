use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User(name: Str, contact: Message): User {
    let this = new User<Message>
    let this.name = name
    let this.contact = contact
    this
}

fn inject<Message>(this: User,) {
    let this.contact =　msg
}

struct Email { address: Str }
fn Email.send(this: Email) {
    print "Send: ", this.address
}

struct Phone { number: Int }
fn Phone.send(this: Email) {
    print "Call: ", this.number
}


fn main() {
    let me = User("x7ea")
    me.set_age(17.4)
    print me
}
