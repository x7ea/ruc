use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User(name: Str): User {
    let this = new User
    let this.name = name
    this
}

fn inject<Message>(this: User, contact: Message) {
    let this.contact = contact
}

struct Email { address: Str }
fn Email.send(this: Email) {
    print "Send: ", this.address
}

struct Phone { number: Int }
fn Phone.send(this: Phone) {
    print "Call: ", this.number
}

fn main() {
    let me = User("x7ea")
    me.inject<Phone>(new Phone)
    me.contact.send()
}
