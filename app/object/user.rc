use std

struct User<Message> {
    name: Str,
    contact: Message
}

fn User<Message>(name: Str, inject: Message): User<Message> {
    let this = new User<Message>
    let id = name + "@example.com"
    let this.contact = inject
    let this.name = id
    this
}

struct Email { address: Str }
fn Email.edit(this: Email, update: Str) let this.address = update
fn Email.access(this: Email) print "Send: ", this.address

struct Phone { number: Int }
fn Phone.edit(this: Phone, update: Int) let this.number = update
fn Phone.access(this: Phone) print "Call: ", this.number

fn main() {
    let me = User<Email>("x7ea", new Email)
    me.contact.send()
    let m = User<Phone>("x7ea", new Phone)
    m.contact.send()
}
