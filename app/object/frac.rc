use std

struct Frac {
    num: Int,
    den: Int
}

fn frac(num: Int, den: Int): Frac {
    let this = new Frac
    let this.den = if den > 0 then den else 1
    let this.num = num
    this
}

fn Frac.gcd(this: Frac): Int {
    let a = abs(this.num)
    let b = abs(this.den)
    while b != 0 do {
        let t = a % b
        let a = b
        let b = t
    }
    a
}

fn Frac.add(a: Frac, b: Frac): Frac {
    let num = (a.num * b.den) + (b.num * a.den)
    let den = a.den * b.den
    frac(num, den)
}

fn Frac.sub(a: Frac, b: Frac): Frac {
    let num = (a.num * b.den) - (b.num * a.den)
    let den = a.den * b.den
    frac(num, den)
}

fn Frac.mul(a: Frac, b: Frac): Frac {
    frac(a.num * b.num, a.den * b.den)
}

fn Frac.div(a: Frac, b: Frac): Frac {
    frac(a.num * b.den, a.den * b.num)
}
fn Frac.print(this: Frac): Str {
    let num = this.num / this.gcd()
    let den = this.den / this.gcd()
    format num, "/", den
}

fn Frac.toFloat(this: Frac): Float {
    let num = this.num.toFloat()
    let den = this.den.toFloat()
    num / den
}

fn main() {
    let x = frac(2, 3) + frac(3, 2)
    print x.toFloat(), " = ", x

    let x = frac(5, 3) - frac(4, 7)
    print x.toFloat(), " = ", x

    let x = frac(3, 8) * frac(5, 2)
    print x.toFloat(), " = ", x

    let x = frac(5, 2) / frac(3, 2)
    print x
}
