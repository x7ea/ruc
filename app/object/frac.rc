use std

struct Frac {
    num: Int,
    den: Int
}

fn frac(num: Int, den: Int): Frac {
    let this = new Frac
    let this.den = if den > 0 then den else 1
    let this.num = num
    this
}

fn Frac.gcd(this: Frac): Int {
    let a = abs(this.num)
    let b = abs(this.den)
    while b != 0 do {
        let t = a % b
        let a = b
        let b = t
    }
    a
}

fn Frac.add(a: Frac, b: Frac): Frac {

}

fn Frac.mul(a: Frac, b: Frac): Frac '
    frac(a.num * b.num, a.den * b.den)

fn Frac.div(a: Frac, b: Frac): Frac '
    frac(a.num * b.den, a.den * b.num)

fn Frac.print(this: Frac): Str {
    let num = this.num / this.gcd()
    let den = this.den / this.gcd()
    format num, "/", den
}

fn Frac.toFloat(this: Frac): Float {
    let num = this.num.toFloat()
    let den = this.den.toFloat()
    num / den
}

fn main() {
    let x = frac(2, 3) * frac(7, 2)
    print x.toFloat(), " = ", x
}
