use std, gtk

struct State {
    count: Int
}

fn view(this: Elm, count: Int) {
    let label = format "Number ", count
    this.update(label)
}

fn model(this: Elm, data: State) {
    let data.count = data.count + 1
    this.view(data.count)
}

fn control(this: App) {
    let data = new State
    let button = app.button("Counter")
    button.click<State>(data, model)
}

fn main() {
    let app = window()
    app.controller()
    app.run()
}
