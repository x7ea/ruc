use std

struct Object<T> {
    raw: T,
    proto: Object<T>(Object<T>, Message<T>)
}

struct Message<T> {
    name: Str,
    args: [Object<Int>]
}

fn Message<T>(name: Str) {
    let this = Message<T>
    let this.name = name
    this
}

fn Object.send<T>(this: Object<T>, message: Message<T>): Object<T> this.proto(Object<T>, message: Message<T>)

fn IntegerReceiver(
    this: Object<Int>,
    message: Message<Int>
): Object<Int> {
    let name = message.name
    let arg = message.args[0]
    if name == "inc" then let this.raw = this.raw + 1
    if name == "add" then let this.raw = this.raw + arg.raw
    if name == "is" then let this.raw = arg.raw
    clone this
}

fn IntegerObject(raw: Int): Object<Int> {
    let this = new Object<Int>
    let this.proto = IntegerReceiver
    let this.raw = raw
    this
}


fn main() {
    let obj = IntegerObject(5)
    obj.send(Message<Int>("inc"))
}
