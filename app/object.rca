use std

struct Object<T> {
    raw: T,
    prpto: Object<T>(Object<T>, Message<T>)
}

struct Message<T> {
    name: Str,
    args: [Object<Int>]
}

fn IntegerReceiver(
    this: Object<Int>,
    message: Message<Int>
): Object<Int> {
    let name = message.name
    if name == "=" then let this.raw = message.args[0].raw
    if name == "+" then let this.raw = this.raw + message.args[0].raw
    clone this
}

fn IntegerObject(raw: Int): Object<Int> {
    let this = new Object<Int>
    let this.prpto = IntegerReceiver
    let this.raw = raw
    this
}


fn main() {
    Object<Int>(5)
}
