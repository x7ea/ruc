use std

struct Object<T> {
    raw: T,
    prpto: Receiver
}

struct Message<T> {
    name: Str,
    args: [Object<Int>]
}

fn IntegerReceiver(
    this: Object<Int>,
    message: Message<Int>
): Object<Int> {
    let name = message.name
    if name == "=" then let this.raw = args[0].raw
    if name == "+" then let this.raw = this.raw + args[0].raw
    clone this
}

fn Object<T>(raw: T): Object<T> {


}


fn main() {
    Object<Int>(5)
}
