use std

struct Object<T> {
    raw: T,
    proto: Object<T>(Object<T>, Message<T>)
}

struct Message<T> {
    name: Str,
    args: [Object<Int>]
}

fn Work<T>(name: Str): Message<T> {
    let this = new Message<T>
    let this.name = name
    this
}

fn Object.send<T>(this: Object<T>, message: Message<T>): Object<T> this.proto(this, message)

fn IntegerReceiver(
    this: Object<Int>,
    message: Message<Int>
): Object<Int> {
    let name = message.name
    let args = message.args
    if name == "inc" then let this.raw = this.raw + 1
    if name == "add" then let this.raw = this.raw + arg[0].raw
    if name == "is"  then let this.raw = arg[0].raw
    clone this
}

fn IntegerObject(raw: Int): Object<Int> {
    let this = new Object<Int>
    let this.proto = IntegerReceiver
    let this.raw = raw
    this
}


fn main() {
    print IntegerObject(5).send(Work<Int>("inc")).raw
}
