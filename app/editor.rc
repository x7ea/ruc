use std

fn main(argc: Int, argv: [Str]) {
    if argc < 3 then {
        print "Ruca Editor"
        exit(1)
    }
    let command = argv[0]
    let src = argv[1]

    if command == "read" then {
        match read_file(src) {
            Some buf = print buf,
            none = print "undefined: " + src
        }
    } else if command == "write" then {
        let content = input()
        write_file(src, content)
    }
}
