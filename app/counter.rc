use std, gtk

struct State {
    count: Int
}

fn inc(this: Elm, data: State) {
    let data.count = data.count + 1
    let view = format "Number ", data.count
    this.update(view)
}

fn main() {
    let app = window()
    let data = new State
    let data.count = 1145141919810
    app.button("Counter").click<State>(data, inc)
    app.run()
}
