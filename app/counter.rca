use gtk

struct State<T> {
    count: T
}

fn inc<T>(this: Elm, data: State<Int>) {
    let data.count = data.count + 1
    let view = format "Number ", data.count
    this.update(view)
}

fn main() {
    let app = App()
    let data = new State<Int>
    app.button("Counter").click<State<Int>>(data, inc)
    app.run()
}
