use std
use gtk

struct State {
    count: Int
}

fn inc(this: Elm, data: State) {
    let data.count = data.count + 1
    let view = format "Number ", data.count
    this.update(view)
}

fn main() {
    let app = window()
    let data = new State
    let data.count = input().atoi()
    app.button(input()).click<State>(data, inc)
    app.run()
}
