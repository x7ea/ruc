enum Result<T, E> {
    ok: T,
    err: E
}

fn safe_div(a: Int, b: Int) {
    let this = new Result<Int, Str>
    if b != 0 then {
        let this.ok = a / b
    } else {
        let this.err = "Zero division"
    }
    this
}

fn print_two_value<A, B>(a: A, b: B) {
    print a
    print b
}

fn main() {
    print safe_div(15, 0).ok
    print_two_value<Int, Float>(1, 1.5)
}
