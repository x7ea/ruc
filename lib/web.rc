extern fn getaddrinfo(addr: Str, port: Str, hint: (), this: Box<Addr>): Int
extern fn freeaddrinfo(this: Addr)

extern fn socket(af: Int, typ: Int, proto: Int): Int
extern fn bind(fd: Int, addr: Addr, len: Int): Int
extern fn listen(fd: Int, n: Int): Int
extern fn accept(fd: Int, addr: Addr, n: Box<Int>): Int
extern fn close(fd: Int)

extern fn read(fd: Int, buf: Str, count: Int)
extern fn write(fd: Int, buf: Str, count: Int)
extern fn sscanf(buf: Str, fmt: Str, a: Str, b: Str)

enum Request {
    get: Str
}

fn server(handle: Str(Request)) {
    let server_addr = calloc<Addr>(48, 1)
    let server_fd = socket(2, 1, 0)

    print getaddrinfo("0.0.0.0", "http", (), Box<Addr>(server_addr))
    print bind(server_fd, server_addr, 48)
    print listen(server_fd, 3)

    while true do {
        let client_addr = calloc<Addr>(48, 1)
        let client_fd = accept(server_fd, client_addr, Box<Int>(48))
        let buf = calloc<Str>(2048, 1)
        read(client_fd, buf, 2048)

        let method = calloc<Str>(16, 1)
        let path = calloc<Str>(256, 1)
        sscanf(buf, "%s %s", method, path)

        if method == "GET" then {
            let req = Request::Get(path)
            let body = handle(req)

            let header = format "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nContent-Length: ", body.len, "\r\n\r\n"
            write(client_fd, header, header.len)
            write(client_fd, body, body.len)
            close(client_fd)
        }
    }
}
