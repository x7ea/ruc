extern fn MHD_create_response_from_buffer_static(size: Int, buf: Str): Content
extern fn MHD_create_response_from_buffer(size: Int, buf: Str, mode: Int): Content
extern fn MHD_queue_response(fd: Network, code: Int, value: Content): Response
extern fn MHD_add_response_header(this: Content, key: Str, value: Str)
extern fn MHD_destroy_response(this: Content)

extern fn MHD_start_daemon: Daemon
extern fn MHD_stop_daemon(this: Daemon)
extern fn MHD_run_from_select

fn __req(http_request_handler: Str(Str, Str), fd: Network, url: Str,
    method: Str, ver: Str, upload: Str, size: Int, con_cls: ()): Response
{
    let page = http_request_handler(method, url)
    let reply = MHD_create_response_from_buffer(page.len, page, 2)
    MHD_add_response_header(reply, "Content-Type", "text/html")
    MHD_add_response_header(reply, "Connection", "close")
    let status = MHD_queue_response(fd, 200, reply)
    MHD_destroy_response(reply)
    status
}

fn server(lambda: Str(Str, Str)) {
    let daemon = MHD_start_daemon(1, 8000, 0, 0, __req, lambda, 0)
    while true do MHD_run_from_select(daemon, 100 * 100)
    MHD_stop_daemon(daemon)
}
