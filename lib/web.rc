extern fn getaddrinfo(addr: Int, port: Str, hint: (), this: Addr)
extern fn freeaddrinfo(this: Addr)

extern fn socket(af: Int, typ: Int, proto: Int): Int
extern fn bind(fd: Int, addr: Addr, len: Int)
extern fn listen(fd; Int, n: Int)

extern fn read(fd: Int, buf: Str, count: Int)
extern fn sscanf(buf: Str, fmt: Str, a: Str, b: Str)

Request

fn server() {
    let addr = calloc<Addr>(48, 1)
    let server_fd = socket(2, 1, 0)
    {
        getaddrinfo(0, "8080", (), addr)
        bind(server_fd, addr, 48)
        listen(server_fd, 3)
    }
    let client_fd = accept(server_fd, addr, Box<Int>(48))
    let buf = calloc<Str>(2048, 1)
    read(client_fd, buf, 2048)

    let method = calloc<Str>(16, 1)
    let path = calloc<Str>(256, 1);
    sscanf(buf, "%s %s", method, path);


}
