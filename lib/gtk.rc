extern fn gtk_main()
extern fn gtk_main_quit()
extern fn gtk_init(argc: (), argv: ())

extern fn gtk_window_new(init: ()): App
extern fn gtk_window_set_default_size(this: App, width: Int, height: Int)

extern fn gtk_button_new_with_label(content: Str): Elm
extern fn gtk_button_set_label(this: Elm, content: Str)
extern fn gtk_container_add(this: App, widget: Elm)

extern fn g_signal_connect_data<T>(this: Elm, event: Str, handle: ()(Elm, T), data: T)
extern fn g_signal_connect_object(this: App, event: Str, handle: ()(), object: ())
extern fn gtk_widget_show_all(window: App)

extern fn gtk_message_dialog_new(widget: Int, modal: Int, type: Int, button: Int, content: Str): MsgBox 
extern fn gtk_dialog_run(this: MsgBox): Bool
extern fn gtk_widget_destroy(this: MsgBox)


fn window(): App {
    gtk_init((), ())
    let this = gtk_window_new(())
    gtk_window_set_default_size(this, 500, 300)
    g_signal_connect_object(this, "destroy", gtk_main_quit, ())
    this
}

fn App.button(this: App, content: Str): Elm {
    let button = gtk_button_new_with_label(content)
    gtk_container_add(this, button)
    button
}

fn Elm.update(this: Elm, content: Str) {
    gtk_button_set_label(this, content)
}

fn Elm.click<T>(this: Elm, data: T, handle: ()(Elm, T)) {
    g_signal_connect_data<T>(this, "clicked", handle, data)
}

fn App.run(this: App) {
    gtk_widget_show_all(this)
    gtk_main()
}

fn msgbox(content: Str): Bool {
    gtk_init((), ())
    let dialog = gtk_message_dialog_new(0, 4, 0, 5, content)
    let result = gtk_dialog_run(dialog)
    gtk_widget_destroy(dialog)
    result
}