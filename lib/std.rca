extern fn strcmp(a: Str, b: Str): Int

fn Str.eq(a: Str, b: Str): Bool strcmp(a, b) == 0
fn Str.add(a: Str, b: Str): Str format a, b

extern fn calloc<T>(size: Int, byte: Int): T
extern fn read(id: Int, buf: Str, size: Int): ()

fn input(): Str {
    let volume = 512
    let buf = calloc<Str>(volume, 8)
    read(0, buf, volume - 1)
    buf
}
