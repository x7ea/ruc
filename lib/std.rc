extern fn calloc<T>(nmemb: Int, size: Int): T
extern fn memcpy<T>(dst: T, src: T, n: Int)
extern fn free<T>(ptr: T)

extern fn strcmp(a: Str, b: Str): Int
extern fn strlen(this: Str): Int

extern fn exit(status_code: Int)

extern fn atoi(src: Str): Int
extern fn g_strdup_printf: Str
extern fn printf

fn Str.add(a: Str, b: Str): Str format a, b

fn Str.eq(a: Str, b: Str): Bool strcmp(a, b) == 0
fn Str.ne(a: Str, b: Str): Bool strcmp(a, b) != 0

fn Bool.print(this: Bool): Str if this then "true" else "false"

extern fn scanf(fmt: Str, buf: Str)
fn input(): Str {
    let buf = calloc<Str>(512, 1)
    scanf("%s", buf)
    buf
}

enum Option<T> {
    some: T,
    none: ()
}

struct Vec<T> {
    raw: [T]
}

fn Vec<T>(value: [T]): Vec<T> {
    let this = new Vec<T>
    let this.raw = value
    this
}

fn Vec.push<T>(this: Vec<T>, value: T) {
    let buf = [T; this.raw.len + 1]

    let index = 0
    for data = this.raw do {
        let buf[index] = data
        let index = index + 1
    }
    let buf[index] = value
    let this.raw = buf
}

fn Vec.print<T>(this: Vec<T>): Str {
    let fmt = "[ "
    for data = this.raw do {
        let fmt = format fmt, data, ", "
    }
    fmt + "]"
}

struct Map<K, V> {
    keys: [K],
    values: [V]
}

fn Map<K, V>(keys: [K], values: [V]): Map<K, V> {
    let this = new Map<K, V>
    let this.keys = keys
    let this.values = values
    this
}

fn Map.index_of<K, V>(this: Map<K, V>, key: K): Option<Int> {
    let index = 0
    while (index < this.keys.len) '
        & (this.keys[index] != key) do {
        let index = index + 1
    }
    if index != this.keys.len then {
        Option<Int>::Some(index)
    } else {
        Option<Int>::None
    }
}

fn Map.get<K, V>(this: Map<K, V>, key: K): Option<V> {
    match this.index_of(key) {
        Some index = Option<V>::Some(this.values[index]),
        None = Option<V>::None
    }
}

fn Map.insert<K, V>(this: Map<K, V>, key: K, value: V) {
    if let index = this.index_of(key).some then {
        let this.values[index] = value
    }
}

extern fn mkdir(path: Str)
extern fn rmdir(path: Str)
extern fn rename(src: Str, dst: Str)

extern fn fopen(path: Str, mode: Str): File
extern fn fclose(fp: File)

extern fn fread(buf: Str, size: Int, byte: Int, fp: File): Int
extern fn fwrite(buf: Str, size: Int, byte: Int, fp: File): Int

extern fn fseek(fp: File, offset: Int, whence: Int)
extern fn ftell(fp: File): Int
extern fn rewind(fp: File)

fn read_file(path: Str): Option<Str> {
    let fp = fopen(path, "r")
    if fp? then () else {
        return Option<Str>::None
    }
    fseek(fp, 0, 2)
    let size = ftell(fp)
    rewind(fp)

    let buf = calloc<Str>(size, 1)
    fread(buf, 1, size, fp)
    fclose(fp)

    Option<Str>::Some(buf)
}

fn write_file(path: Str, content: Str) {
    let fp = fopen(path, "w")
    if fp? then {
        fwrite(content, 1, content.len, fp)
        fclose(fp)
    }
}

extern fn getpid(): Int
extern fn srand(seed: Int)
extern fn time(t: Int): Int
extern fn rand(): Int

fn random(min: Int, max: Int): Int {
    srand(time(0) + getpid())
    (rand() % max) + min
}
